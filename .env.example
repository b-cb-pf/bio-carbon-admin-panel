# Keep this true while developing without a backend.
NEXT_PUBLIC_USE_MOCK_API=true

# When mocks are disabled, requests are sent to this URL.
# Prefer /api and implement Next.js Route Handlers as a secure backend proxy.
NEXT_PUBLIC_API_BASE_URL=/api

# Optional artificial delay for mock responses, in milliseconds.
NEXT_PUBLIC_MOCK_API_DELAY=250
