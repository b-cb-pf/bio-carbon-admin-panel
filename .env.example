# Unconnected modules still use mock data. Platform auth and tenant explicitly
# use the backend regardless of this setting.
NEXT_PUBLIC_USE_MOCK_API=true

# The local platform backend runs on port 3000. Run this frontend on port 3001.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# This account is always read-only in the staff list and cannot be deactivated
# or deleted. Keep it aligned with the backend's primary staff configuration.
NEXT_PUBLIC_PRIMARY_ADMIN_EMAIL=biocarbonprofile@gmail.com

# Optional artificial delay for mock responses, in milliseconds.
NEXT_PUBLIC_MOCK_API_DELAY=250
